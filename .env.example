# ======================== AMBIENTE DE DESENVOLVIMENTO ========================
# Copie este arquivo para ".env" na raiz do repo (ele já está no .gitignore)
# e ajuste apenas se alterar portas ou senhas no docker-compose.yml

# ---------- Microserviço: ESTOQUE (porta :8081) ----------
PORT=8081
DB_HOST=localhost
DB_PORT=15432
DB_USER=korp
DB_PASS=korp
DB_NAME=estoque
# Pool (valores padrão; ajuste se precisar):
DB_POOL_MAX=20

# ---------- Microserviço: FATURAMENTO (porta :8082) ----------
# (duplique este bloco para rodar separado; este .env.example funciona
#  para o serviço que você exportar SERVICE_NAME antes de subir)
SERVICE_NAME=estoque
VERSION=1.0.0

# ---------- RabbitMQ (broker de mensagens) ----------
# Formato completo amqp://USER:PASS@HOST:PORT/VHOST (vazio = "/" default)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ---------- Observabilidade ----------
# Valores aceitos: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ======================== AMBIENTE DE PRODUÇÃO ==============================
# - Não use "localhost" em nenhum host.
# - Não use credenciais fixas; use secrets da sua plataforma.
# - Não comite o .env final: ele já está no .gitignore!
